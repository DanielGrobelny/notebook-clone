{
  "name": "notebook-clone",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:storage": "RUN_INTEGRATION=1 playwright test tests/e2e/source-storage-delete.integration.spec.ts",
    "test:integration:openai": "RUN_INTEGRATION=1 RUN_OPENAI_INTEGRATION=1 playwright test tests/e2e/chat-openai.integration.spec.ts --project=desktop",
    "eval:quality": "node scripts/run-quality-eval.mjs",
    "test:visitor": "node scripts/test-visitor-stack.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.108",
    "@ai-sdk/react": "4.0.166",
    "@supabase/ssr": "0.5.2",
    "@supabase/supabase-js": "2.50.0",
    "ai": "7.0.162",
    "lucide-react": "1.67.0",
    "next": "16.4.4",
    "pdfjs-dist": "5.4.624",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.4",
    "jsdom": "30.1.3",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "supabase": "2.39.2",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "supabase"
    ]
  }
}
